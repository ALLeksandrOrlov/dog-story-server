{
  "uid": "dog-story",
  "title": "Dog Story — Server",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "dog-story"
  ],
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Requests per second",
      "description": "API and static file responses. HTTP status classes limit the number of time series.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "dog-story-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dog-story-prometheus"
          },
          "expr": "sum by (status_class) (rate(dog_story_http_requests_total{job=\"dog-story\"}[$__rate_interval]))",
          "legendFormat": "{{status_class}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "title": "Response preparation latency",
      "description": "Time until the response is ready to send, as recorded in server logs. Excludes network transfer; source precision is 1 ms.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "dog-story-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dog-story-prometheus"
          },
          "expr": "sum(rate(dog_story_http_request_duration_seconds_sum{job=\"dog-story\"}[$__rate_interval])) / clamp_min(sum(rate(dog_story_http_request_duration_seconds_count{job=\"dog-story\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "Average",
          "refId": "A",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dog-story-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(dog_story_http_request_duration_seconds_bucket{job=\"dog-story\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "refId": "B",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "title": "HTTP error ratio",
      "description": "Share of each status class among all responses.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "dog-story-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dog-story-prometheus"
          },
          "expr": "100 * sum(rate(dog_story_http_requests_total{job=\"dog-story\",status_class=\"4xx\"}[$__rate_interval])) / clamp_min(sum(rate(dog_story_http_requests_total{job=\"dog-story\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "4xx",
          "refId": "A",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dog-story-prometheus"
          },
          "expr": "100 * sum(rate(dog_story_http_requests_total{job=\"dog-story\",status_class=\"5xx\"}[$__rate_interval])) / clamp_min(sum(rate(dog_story_http_requests_total{job=\"dog-story\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "5xx",
          "refId": "B",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "title": "Metrics collection availability",
      "description": "1 means available; 0 means unavailable. Exporter availability does not indicate game health.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "dog-story-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dog-story-prometheus"
          },
          "expr": "up{job=~\"dog-story|node\"}",
          "legendFormat": "{{job}}",
          "refId": "A",
          "range": false,
          "instant": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dog-story-prometheus"
          },
          "expr": "dog_story_log_readable{job=\"dog-story\"}",
          "legendFormat": "Log available",
          "refId": "B",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 5,
      "title": "Linux host CPU",
      "description": "On Docker Desktop/Lima, this measures the Linux VM CPU rather than the physical macOS host.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "dog-story-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dog-story-prometheus"
          },
          "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{job=\"node\",mode=\"idle\"}[$__rate_interval])))",
          "legendFormat": "CPU",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "title": "Linux host memory",
      "description": "Used Linux host memory; available memory includes reclaimable file cache.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "dog-story-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dog-story-prometheus"
          },
          "expr": "100 * (1 - node_memory_MemAvailable_bytes{job=\"node\"} / node_memory_MemTotal_bytes{job=\"node\"})",
          "legendFormat": "RAM",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "title": "Filesystem usage",
      "description": "Percentage of space unavailable to an ordinary user, including filesystem reserved space.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "dog-story-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dog-story-prometheus"
          },
          "expr": "100 * (1 - node_filesystem_avail_bytes{job=\"node\",fstype!~\"tmpfs|devtmpfs|overlay|squashfs\",mountpoint!~\"/host.*\"} / node_filesystem_size_bytes{job=\"node\",fstype!~\"tmpfs|devtmpfs|overlay|squashfs\",mountpoint!~\"/host.*\"})",
          "legendFormat": "{{mountpoint}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "title": "Linux host disk I/O",
      "description": "All Linux host devices; virtual and composite devices may count the same I/O more than once.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "dog-story-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dog-story-prometheus"
          },
          "expr": "sum(rate(node_disk_read_bytes_total{job=\"node\"}[$__rate_interval]))",
          "legendFormat": "Read",
          "refId": "A",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dog-story-prometheus"
          },
          "expr": "sum(rate(node_disk_written_bytes_total{job=\"node\"}[$__rate_interval]))",
          "legendFormat": "Write",
          "refId": "B",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "title": "Log collection errors",
      "description": "Read errors and malformed or oversized entries; the game server continues to run.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "dog-story-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dog-story-prometheus"
          },
          "expr": "rate(dog_story_log_parse_errors_total{job=\"dog-story\"}[$__rate_interval])",
          "legendFormat": "Entry format",
          "refId": "A",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dog-story-prometheus"
          },
          "expr": "rate(dog_story_log_read_errors_total{job=\"dog-story\"}[$__rate_interval])",
          "legendFormat": "File read",
          "refId": "B",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 10,
      "title": "Request handler errors",
      "description": "Request failed events, tracked separately from HTTP 5xx because a response may not have been produced.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "dog-story-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dog-story-prometheus"
          },
          "expr": "rate(dog_story_request_failures_total{job=\"dog-story\"}[$__rate_interval])",
          "legendFormat": "request failed",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ],
  "links": []
}
